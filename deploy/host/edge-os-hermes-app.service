[Unit]
Description=Edge OS Hermes relay application (host-side, loopback only)
Documentation=file:/opt/edge-os/deploy/coolify/RUNBOOK.md
Requires=edge-os-socket-proxy.service
After=edge-os-socket-proxy.service docker.service
Wants=docker.service
# Fail closed until an approved ACTUAL relay operation exists and the controller wrote its handoff line.
ConditionPathExists=/etc/edge-os/hermes-app.enabled

[Service]
Type=simple
User=edge-os-research
Group=edge-os-relay-share
SupplementaryGroups=edge-os-research
WorkingDirectory=/opt/edge-os
EnvironmentFile=/etc/edge-os/hermes-app.env
Environment=EDGE_OS_APP_BIND_HOST=127.0.0.1
Environment=DOCKER_HOST=unix:///run/edge-os/research/docker.sock
Environment=DOCKER_CONFIG=/var/lib/edge-os/research/docker-config
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/edge-os/apps/api/src:/opt/edge-os/scripts/hermes_job_support:/opt/edge-os/scripts/hermes_interpretation:/opt/edge-os/scripts/hermes_provider_relay
ExecStart=/opt/edge-os/apps/api/.venv/bin/python /opt/edge-os/scripts/hermes_app_mount/serve_relay_application.py --handoff-path ${EDGE_OS_HANDOFF_PATH} --handoff-sha256 ${EDGE_OS_HANDOFF_SHA256} --run-id ${EDGE_OS_RUN_ID} --port 8011
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
# Read-write at the mount level only. DAC keeps the application inside grants/, revocations/ and the channel: the
# relay's config, key, tls, provider and gateway folders are not group-writable, and state/ is read-only for it.
ReadWritePaths=/var/lib/edge-os/research /var/lib/edge-os/channel /var/lib/edge-os/relay

[Install]
WantedBy=multi-user.target
