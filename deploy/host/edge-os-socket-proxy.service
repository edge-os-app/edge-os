[Unit]
Description=Edge OS host Docker socket proxies (research and relay)
Documentation=file:/opt/edge-os/deploy/coolify/RUNBOOK.md
Requires=docker.service
After=docker.service
Before=edge-os-research-worker.service edge-os-hermes-relay.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/edge-os/socket-proxy.env
# The proxy containers run as the role proxy users and create their Unix sockets here. The directories must belong to
# the proxy user with the service group, so the service user can open the socket and cannot open the real socket.
ExecStartPre=/bin/sh -c 'install -d -m 0750 -o "$EDGE_OS_PROXY_RESEARCH_UID" -g "$EDGE_OS_RESEARCH_GID" /run/edge-os/research && install -d -m 0750 -o "$EDGE_OS_PROXY_RELAY_UID" -g "$EDGE_OS_RELAY_GID" /run/edge-os/relay'
ExecStart=/usr/bin/docker compose -f /opt/edge-os/deploy/host/docker-socket-proxy.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f /opt/edge-os/deploy/host/docker-socket-proxy.yml down
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
