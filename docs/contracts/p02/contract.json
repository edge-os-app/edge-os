    "constant": {
      "shape": [
        "op",
        "value",
        "unit"
      ],
      "result": "numeric:declared-unit"
    },
    "price": {
      "shape": [
        "op"
      ],
      "result": "numeric:quote-per-base"
    },
    "quote_volume": {
      "shape": [
        "op"
      ],
      "result": "numeric:declared-quote-asset"
    },
    "price_return": {
      "shape": [
        "op",
        "lookback_buckets"
      ],
      "result": "numeric:dimensionless",
      "history": "qualified-endpoints; retain-intermediate-gaps"
    },
    "lag": {
      "shape": [
        "op",
        "value",
        "buckets"
      ],
      "result": "numeric:input-unit",
      "history": "one-scheduled-position"
    },
    "sum": {
      "shape": [
        "op",
        "value",
        "buckets"
      ],
      "result": "numeric:input-unit",
      "history": "all-scheduled-values-required"
    },
    "mean": {
      "shape": [
        "op",
        "value",
        "buckets"
      ],
      "result": "numeric:input-unit",
      "history": "all-scheduled-values-required"
    },
    "gt": {
      "shape": [
        "op",
        "args[2]"
      ],
      "result": "boolean",
      "requires": "same-numeric-unit"
    },
    "gte": {
      "shape": [
        "op",
        "args[2]"
      ],
      "result": "boolean",
      "requires": "same-numeric-unit"
    },
    "lt": {
      "shape": [
        "op",
        "args[2]"
      ],
      "result": "boolean",
      "requires": "same-numeric-unit"
    },
    "lte": {
      "shape": [
        "op",
        "args[2]"
      ],
      "result": "boolean",
      "requires": "same-numeric-unit"
    },
    "and": {
      "shape": [
        "op",
        "args[2]"
      ],
      "result": "boolean",
      "requires": "boolean-operands",
      "truth": "kleene-whole-tree"
    },
    "or": {
      "shape": [
        "op",
        "args[2]"
      ],
      "result": "boolean",
      "requires": "boolean-operands",
      "truth": "kleene-whole-tree"
    },
    "not": {
      "shape": [
        "op",
        "value"
      ],
      "result": "boolean",
      "requires": "boolean-operand",
      "truth": "kleene-whole-tree"
    }
  },
