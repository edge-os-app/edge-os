{
  "description": "Per-session controller SessionStart binding and Stop guard. Project trust and hook trust remain required.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/controller_guard.py\" session-start codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/controller_guard.py\" hook codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
